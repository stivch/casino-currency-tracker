{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "111",

  "permissions": ["storage", "alarms", "notifications", "scripting"],

  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://open.er-api.com/*"
  ],

  "optional_host_permissions": [],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "src/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://stake.com/*",
        "https://*.stake.com/*",
        "https://stake.bet/*",
        "https://*.stake.bet/*",
        "https://stake.games/*",
        "https://*.stake.games/*",
        "https://stake.us/*",
        "https://*.stake.us/*",
        "https://duel.com/*",
        "https://*.duel.com/*",
        "https://duel.limited/*",
        "https://*.duel.limited/*",
        "https://duel.vip/*",
        "https://*.duel.vip/*",
        "https://duel.net/*",
        "https://*.duel.net/*"
      ],
      "js": ["src/lib/stakebridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://stake.com/*",
        "https://*.stake.com/*",
        "https://stake.bet/*",
        "https://*.stake.bet/*",
        "https://stake.games/*",
        "https://*.stake.games/*",
        "https://stake.us/*",
        "https://*.stake.us/*",
        "https://duel.com/*",
        "https://*.duel.com/*",
        "https://duel.limited/*",
        "https://*.duel.limited/*",
        "https://duel.vip/*",
        "https://*.duel.vip/*",
        "https://duel.net/*",
        "https://*.duel.net/*"
      ],
      "js": ["src/lib/scrape.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
